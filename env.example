# Web server
PORT=29137
PUBLIC_URL=http://localhost:29137

# Admin web UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Data storage (mounted volume in Docker)
DATA_DIR=/data

# Huawei registration
REG_AREA_CODE=OM
# Optional GeeTest solver: set to an HTTP endpoint that accepts JSON and returns {"validate":"..."}
CAPTCHA_SOLVER_URL=

# Outbound proxy (optional)
HTTPS_PROXY=
HTTP_PROXY=

# Huawei Cloud model proxy (CodeArts channel only)
# API_KEY is optional; if empty, /v1/models and /v1/chat/completions are open.
API_KEY=
HUAWEI_MODEL_BASE=https://snap-access.ap-southeast-1.myhuaweicloud.com
# Optional explicit upstream model list URL. If empty, known upstream endpoints are tried.
HUAWEI_MODELS_URL=
# Background quota sync interval (Go duration, default 30m)
QUOTA_SYNC_INTERVAL=30m

# Track 1a：等待期先发 message_start。EARLY_ENVELOPE=0 回退裸 ping。
EARLY_ENVELOPE=1

# Scheduler — ready 号 sticky 更久；透支号仍 2 轮换号。ROTATE_BY_GATE=0 回退全局 2。
ROTATE_BY_GATE=1
ROTATE_AFTER_READY=5
ROTATE_AFTER_DEPLETED=2
# 透支号首字节超时（默认 40s），避免卡到 Claude Code 断线
HEADER_WAIT_DEPLETED=40s
NONSTREAM_TIMEOUT_DEPLETED=45s

# Per-key 公平：RPM=0 关闭；在途默认 8
KEY_RPM=0
KEY_MAX_INFLIGHT=8


# ── 国内码道 CN 渠道 ─────────────────────────────
CN_ENABLED=true
CN_AUTH_DIR=./auths
CN_DEFAULT_MODEL=snap-chat
CN_CREDITS_AUTO_CLAIM=true   # 每日签到/积分自动领取
CN_BENEFIT_AUTO_CLAIM=true   # 限时福利模型自动领取
CN_WATCH_POLL=30m            # 续期/签到/保活轮询周期
CN_REFRESH_SKEW=30m
CN_KEEPALIVE_WINDOW=10m
CN_KEEPALIVE_INTERVAL=15m
CN_MAX_CONCURRENT=5          # 单 CN 账号并发上限
CN_UPSTREAM_TIMEOUT=120s
CN_SOFT_COOLDOWN=15m         # CN 渠道长失败黑名单冷却
CN_ERR_THRESHOLD=5           # 连败熔断阈值（达到后暂时摘除）
CN_ERR_COOLDOWN=2m           # 熔断短冷却

# ── 网关通用调优（默认即可） ───────────────────────
HUAWEI_DISPATCH_RPS=2        # 上游聚合速率限（req/s）
FORCE_THINKING=1             # 为支持模型强制追加 thinking 协议
SSE_IDLE_TIMEOUT=15s         # SSE 静默超时（上游拉稀旁路用）
RESP_CACHE_TTL=2s            # 防重放：同 prompt 短TTL复用
# BASE_PATH=/sub             # 反代挂在子路径时置此项
# DATA_DIR 备注：Docker 默认 /data（compose 挂载卷）；裸机默认 ./data；如需自定请显式覆盖：
# DATA_DIR=./data
